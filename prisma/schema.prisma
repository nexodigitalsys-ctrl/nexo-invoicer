generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Workspace {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clientes      Cliente[]
  empresaConfig EmpresaConfig?
  facturas      Factura[]
  memberships   Membership[]
  presupuestos  Presupuesto[]
  servicios     Servicio[]
}

model Membership {
  id          Int       @id @default(autoincrement())
  userId      Int
  workspaceId Int
  role        String    @default("owner")
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model Cliente {
  id           Int           @id @default(autoincrement())
  workspaceId  Int
  nombre       String
  nif          String
  email        String?
  telefono     String?
  direccion    String?
  cp           String?
  ciudad       String?
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  facturas     Factura[]
  presupuestos Presupuesto[]
}

model Servicio {
  id                Int                @id @default(autoincrement())
  workspaceId       Int
  nombre            String
  descripcion       String?
  precio            Float?
  activo            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  lineasFactura     FacturaLinea[]
  lineasPresupuesto PresupuestoLinea[]
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
}

model Presupuesto {
  id            Int                @id @default(autoincrement())
  workspaceId   Int
  numero        String
  clienteId     Int
  fecha         DateTime           @default(now())
  estado        String             @default("borrador")
  subtotal      Float              @default(0)
  descuentoPorcentaje Float        @default(0)
  descuentoImporte    Float        @default(0)
  ivaPorcentaje Float              @default(21)
  ivaImporte    Float              @default(0)
  total         Float              @default(0)
  notas         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  cliente       Cliente            @relation(fields: [clienteId], references: [id])
  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  lineas        PresupuestoLinea[]

  @@unique([workspaceId, numero])
}

model PresupuestoLinea {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  servicioId     Int?
  descripcion    String
  cantidad       Int
  precioUnitario Float
  totalLinea     Float
  createdAt      DateTime    @default(now())
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id])
  servicio       Servicio?   @relation(fields: [servicioId], references: [id])
}

model Factura {
  id            Int            @id @default(autoincrement())
  workspaceId   Int
  numero        String
  clienteId     Int
  fecha         DateTime       @default(now())
  estado        String         @default("borrador")
  subtotal      Float          @default(0)
  descuentoPorcentaje Float    @default(0)
  descuentoImporte    Float    @default(0)
  ivaPorcentaje Float          @default(21)
  ivaImporte    Float          @default(0)
  total         Float          @default(0)
  notas         String?
  createdAt     DateTime       @default(now())
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  lineas        FacturaLinea[]

  @@unique([workspaceId, numero])
}

model FacturaLinea {
  id             Int       @id @default(autoincrement())
  facturaId      Int
  servicioId     Int?
  descripcion    String
  cantidad       Int       @default(1)
  precioUnitario Float
  totalLinea     Float
  factura        Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  servicio       Servicio? @relation(fields: [servicioId], references: [id])
}

model EmpresaConfig {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @unique
  nombre      String
  nif         String?
  direccion   String?
  cp          String?
  ciudad      String?
  provincia   String?
  telefono    String?
  email       String?
  web         String?
  iban        String?
  logoPath    String?
  idioma      String    @default("es")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}
